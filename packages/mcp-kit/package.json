{
  "name": "@leochat/mcp-kit",
  "version": "0.0.1",
  "private": true,
  "description": "Expose @leochat/core tools as a stateless MCP server (Workers-ready) and use MCP servers as a ToolSource.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1"
  },
  "peerDependencies": {
    "@leochat/core": "*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@leochat/core": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0",
    "zod": "^4.3.6"
  }
}
