{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    // 零 Node 依赖：不加载 @types/node，只允许 ES2022 和 Web 标准 API
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@leochat/core": ["../core/src/index.ts"],
      "@leochat/core/testing": ["../core/src/testing/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
